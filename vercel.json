{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/penelitian-detail",
      "destination": "/penelitian-detail.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/add",
      "destination": "/admin/add.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin/staff",
      "destination": "/admin/staff.html"
    },
    {
      "source": "/admin/struktur",
      "destination": "/admin/struktur.html"
    },
    {
      "source": "/admin/staff-form",
      "destination": "/admin/staff-form.html"
    },
    {
      "source": "/admin/penelitian",
      "destination": "/admin/penelitian.html"
    },
    {
      "source": "/admin/penelitian-form",
      "destination": "/admin/penelitian-form.html"
    },
    {
      "source": "/admin/pencapaian",
      "destination": "/admin/pencapaian.html"
    },
    {
      "source": "/admin/pencapaian-form",
      "destination": "/admin/pencapaian-form.html"
    },
    {
      "source": "/admin/mitra",
      "destination": "/admin/mitra.html"
    },
    {
      "source": "/admin/mitra-form",
      "destination": "/admin/mitra-form.html"
    },
    {
      "source": "/berita-detail",
      "destination": "/berita-detail.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}